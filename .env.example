# Postgres (Supabase). DATABASE_URL is the pooled connection (pgbouncer,
# port 6543) used at runtime — required for serverless (Vercel). DIRECT_URL
# is the direct connection (port 5432) used only for migrations.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Resume file storage: "local" (default, writes to data/applications — dev
# only, doesn't survive serverless) or "vercel-blob" (production).
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=

# AI provider: "mock" (default, no key needed), "anthropic", or "gemini"
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Email provider: "mock" (default, no key needed, shows what would be sent) or "resend"
EMAIL_PROVIDER=mock
RESEND_API_KEY=
FROM_EMAIL=hiring@kargo.example

# Not used by the app directly (Resend is the email sender per spec) — placeholder if a
# Gmail-based flow is added later.
GMAIL_API_KEY=
