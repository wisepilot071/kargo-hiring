# Database (SQLite for local prototype)
DATABASE_URL="file:./dev.db"

# AI provider: "mock" (default, no key needed) or "anthropic"
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Email provider: "mock" (default, no key needed, shows what would be sent) or "resend"
EMAIL_PROVIDER=mock
RESEND_API_KEY=
FROM_EMAIL=hiring@kargo.example

# Not used by the app directly (Resend is the email sender per spec) — placeholder if a
# Gmail-based flow is added later.
GMAIL_API_KEY=
